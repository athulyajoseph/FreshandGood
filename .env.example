# Copy to .env.local and adjust. All client-side vars must be prefixed with VITE_.

# WhatsApp number in international format, digits only (no +, spaces or dashes).
VITE_WHATSAPP_NUMBER=919800000000

# Public site URL, used for canonical links and the sitemap (Phase 4).
VITE_SITE_URL=https://freshandgood.example.com
