# Copy to .env.local and fill in. Only variables prefixed with VITE_ reach the browser,
# so never put secrets here. On Vercel / Netlify, set these in the project settings instead.

# Public site URL, no trailing slash. Used for canonical links, Open Graph tags,
# sitemap.xml and robots.txt. Defaults to a placeholder domain if unset.
VITE_SITE_URL=https://freshandgood.example.com

# WhatsApp number in international format, digits only (no +, spaces or dashes).
# Overrides the number in src/data/siteConfig.ts.
VITE_WHATSAPP_NUMBER=919800000000

# Contact form (Web3Forms, https://web3forms.com — free). Create an access key with the
# email address that should receive messages. If either value is empty, the Contact page
# shows email and WhatsApp links instead of the form.
VITE_CONTACT_FORM_ENDPOINT=https://api.web3forms.com/submit
VITE_CONTACT_FORM_KEY=
